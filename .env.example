# ==========================================
# 7X_SHOP.com Environment Variables Template
# ==========================================

# Port (Google Cloud Run automatically sets PORT to 8080)
PORT=8080
NODE_ENV=production

# Public URL of the deployed application (used for dynamic sitemap and SEO)
APP_URL=https://your-service-name.a.run.app

# Admin Dashboard Password (Change to a strong secret in production)
ADMIN_PASSWORD=change_this_to_a_secure_admin_password

# Telegram Bot Instant Order Notifications
# Get your BOT TOKEN from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# Your Telegram Group or Channel Chat ID (e.g., -100xxxxxxxxxx or @channel_username)
TELEGRAM_CHAT_ID=

# Optional: Server-side Gemini API Key
# GEMINI_API_KEY=
